{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "priority_order", "providers"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "priority_order": {
      "type": "array",
      "items": {"enum": ["PRIMARY_ORIGINAL", "DIRECT_SPECIALIST", "INDEPENDENT_REPORTING", "DISCOVERY_AGGREGATOR"]},
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true
    },
    "providers": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider_id", "role", "adapter", "enabled", "required", "authority_level", "auth_mode", "endpoints", "timeout_seconds", "retry", "rate_limit", "cache_ttl_seconds", "integration_test_status", "fallbacks", "license_terms_notes", "source_classification", "provenance_behavior"],
        "properties": {
          "provider_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$"},
          "role": {"enum": ["PRIMARY", "SPECIALIST", "INDEPENDENT", "DISCOVERY"]},
          "adapter": {"type": "string"},
          "enabled": {"type": "boolean"},
          "required": {"type": "boolean"},
          "authority_level": {"enum": ["PRIMARY_ORIGINAL", "DIRECT_SPECIALIST", "INDEPENDENT_REPORTING", "DISCOVERY_AGGREGATOR"]},
          "auth_mode": {"enum": ["none", "environment"]},
          "endpoints": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri", "pattern": "^https://"}},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120},
          "retry": {"type": "integer", "minimum": 0, "maximum": 3},
          "rate_limit": {"type": "string", "minLength": 1},
          "cache_ttl_seconds": {"type": "integer", "minimum": 0},
          "integration_test_status": {"enum": ["PASS", "NOT_RUN", "FAIL"]},
          "fallbacks": {"type": "array", "items": {"type": "string"}},
          "license_terms_notes": {"type": "string", "minLength": 1},
          "source_classification": {"type": "string", "minLength": 1},
          "provenance_behavior": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
