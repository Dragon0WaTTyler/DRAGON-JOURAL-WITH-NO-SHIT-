{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "source_records", "duplicate_groups", "event_clusters", "summary"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "PASS"},
    "source_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "canonical_url", "discovered_url", "publisher", "author", "title", "source_type", "retrieved_at", "published_at", "fetch_status", "http_status", "extraction_method", "extraction_quality", "content_hash", "language", "primary_or_secondary", "authority_level", "independent_origin_group", "wire_origin", "archive_reference", "license_use_notes", "doi", "publication_status", "full_text_status", "methods_read", "limitations_read", "uncertainty", "event_ids", "claims_supported"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "canonical_url": {"type": "string", "pattern": "^https://"},
          "discovered_url": {"type": "string", "pattern": "^https://"},
          "publisher": {"type": ["string", "null"]},
          "author": {"type": ["string", "null"]},
          "title": {"type": ["string", "null"]},
          "source_type": {"type": ["string", "null"]},
          "retrieved_at": {"type": ["string", "null"]},
          "published_at": {"type": ["string", "null"]},
          "fetch_status": {"enum": ["PROVIDER_REPORTED"]},
          "http_status": {"type": ["integer", "null"]},
          "extraction_method": {"type": "string"},
          "extraction_quality": {"enum": ["UNVERIFIED"]},
          "content_hash": {"type": ["string", "null"]},
          "language": {"type": ["string", "null"]},
          "primary_or_secondary": {"type": ["string", "null"]},
          "authority_level": {"enum": ["PRIMARY", "SECONDARY"]},
          "independent_origin_group": {"type": "string", "minLength": 1},
          "wire_origin": {"type": ["string", "null"]},
          "archive_reference": {"type": ["string", "null"]},
          "license_use_notes": {"type": ["string", "null"]},
          "doi": {"type": ["string", "null"]},
          "publication_status": {"type": ["string", "null"]},
          "full_text_status": {"type": ["string", "null"]},
          "methods_read": {"type": "boolean"},
          "limitations_read": {"type": "boolean"},
          "uncertainty": {"type": "array", "items": {"type": "string"}},
          "event_ids": {"type": "array", "items": {"type": "string", "pattern": "^EVT-[A-F0-9]{12}$"}},
          "claims_supported": {"type": "array", "items": {"type": ["string", "null"]}}
        }
      }
    },
    "duplicate_groups": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "canonical_url", "source_ids"],
        "properties": {
          "kind": {"const": "EXACT_CANONICAL_URL"},
          "canonical_url": {"type": "string"},
          "source_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}}
        }
      }
    },
    "event_clusters": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["event_id", "candidate_keys", "source_ids", "publisher_count", "independent_origin_count", "independent_origin_groups", "wire_origins"],
        "properties": {
          "event_id": {"type": "string", "pattern": "^EVT-[A-F0-9]{12}$"},
          "candidate_keys": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "publisher_count": {"type": "integer", "minimum": 0},
          "independent_origin_count": {"type": "integer", "minimum": 0},
          "independent_origin_groups": {"type": "array", "items": {"type": "string"}},
          "wire_origins": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["source_count", "canonical_source_count", "duplicate_group_count", "event_count", "wire_source_count"],
      "properties": {
        "source_count": {"type": "integer", "minimum": 0},
        "canonical_source_count": {"type": "integer", "minimum": 0},
        "duplicate_group_count": {"type": "integer", "minimum": 0},
        "event_count": {"type": "integer", "minimum": 0},
        "wire_source_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
