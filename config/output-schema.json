{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daily Newspaper Story Packet",
  "type": "object",
  "required": [
    "story_id", "proposed_title", "importance_score", "what_happened",
    "key_facts", "primary_sources", "independent_sources",
    "contradictory_evidence", "uncertainty", "context", "why_it_matters",
    "strategic_angle", "confidence", "recommendation"
  ],
  "properties": {
    "story_id": {"type": "string", "minLength": 1},
    "proposed_title": {"type": "string", "minLength": 1},
    "importance_score": {"type": "number", "minimum": 0, "maximum": 10},
    "what_happened": {"type": "string", "minLength": 1},
    "key_facts": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "primary_sources": {"type": "array", "items": {"type": "string"}},
    "independent_sources": {"type": "array", "items": {"type": "string"}},
    "contradictory_evidence": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "string", "minLength": 1},
    "context": {"type": "string", "minLength": 1},
    "why_it_matters": {"type": "string", "minLength": 1},
    "strategic_angle": {"type": "string", "minLength": 1},
    "confidence": {"enum": ["high", "medium", "low"]},
    "recommendation": {"enum": ["LEAD", "PUBLISH", "BRIEF", "HOLD", "REJECT"]}
  },
  "additionalProperties": false
}
